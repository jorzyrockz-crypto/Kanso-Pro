{
  "id": "/",
  "name": "Kanso Pro",
  "short_name": "Kanso Pro",
  "description": "Your local-first space for events, tasks, projects, and journal reflections.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#eaf5fc",
